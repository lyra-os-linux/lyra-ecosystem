{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vega",
  "version": "0.1.0",
  "identifier": "org.lyraos.VegaTauri",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "enableGTKAppId": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vega",
        "width": 1180,
        "height": 780,
        "minWidth": 400,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
